{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "release: Tomodachi ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Improvements" },
    { "type": "refactor", "section": "Improvements" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "release", "section": "Release", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "tomodachi",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mac-demo/NotchBuddy/project.yml" },
        {
          "type": "xml",
          "path": "mac-demo/NotchBuddy/Resources/Info.plist",
          "xpath": "//plist/dict/key[text()='CFBundleShortVersionString']/following-sibling::string[1]"
        }
      ]
    }
  }
}
